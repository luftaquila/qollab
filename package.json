{
  "name": "qollab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch apps/server/src/main.ts",
    "dev:web": "npm run dev -w @qollab/web",
    "build": "npm run build -w @qollab/web && tsup apps/server/src/main.ts apps/renderer/src/main.ts --format esm --out-dir dist --sourcemap --external jsdom",
    "check": "tsc --noEmit && vue-tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "start": "node --env-file-if-exists=.env dist/server/src/main.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/static": "10.1.5",
    "@fastify/websocket": "11.2.0",
    "@milkdown/crepe": "7.22.2",
    "@milkdown/kit": "7.22.2",
    "@milkdown/plugin-collab": "7.22.2",
    "fastify": "5.12.5",
    "fflate": "0.8.3",
    "jsdom": "27.4.0",
    "openid-client": "6.8.8",
    "pg": "8.16.3",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "sharp": "0.35.5",
    "unified": "11.0.5",
    "vue": "3.5.43",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yaml": "2.9.1",
    "yjs": "13.6.31",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/jsdom": "27.0.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-vue": "6.0.4",
    "jose": "6.2.2",
    "pdfjs-dist": "6.4.299",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "4.1.11",
    "vue-tsc": "3.2.5",
    "ws": "8.22.0"
  },
  "overrides": {
    "vue": "$vue",
    "yjs": "$yjs"
  }
}
