PUBLIC_ORIGIN=http://localhost:3000
PORT=3000
BIND_ADDRESS=127.0.0.1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAIN=
ACCOUNT_POLICY=approval
APPROVED_EMAILS=
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgres://qollab:qollab-local@127.0.0.1:55432/qollab
RENDERER_TOKEN=replace-with-at-least-32-random-characters
ADMIN_TOKEN=replace-with-another-32-random-characters
DATA_DIR=.data
APP_IMAGE=ghcr.io/luftaquila/qollab:0.1.5
RENDER_IMAGE=ghcr.io/luftaquila/qollab-renderer:0.1.5
ENGINE_SOCKET=/var/run/docker.sock
RENDERER_NAMESPACE=qollab
RENDER_WARM_MS=30000
BUILD_DEBOUNCE_MS=75
