PUBLIC_ORIGIN=http://localhost:3000
PORT=3000
BIND_ADDRESS=127.0.0.1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAIN=
ACCOUNT_POLICY=approval
APPROVED_EMAILS=
# Member notification mail (STARTTLS on 587; implicit TLS on 465).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional separate document application tool (/apply/).
APPLY_INTERNAL_ORIGIN=
ANONYMOUS_ACCESS=false
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgres://qollab:qollab-local@127.0.0.1:55432/qollab
RENDERER_TOKEN=replace-with-at-least-32-random-characters
ADMIN_TOKEN=replace-with-another-32-random-characters
DATA_DIR=.data
APP_IMAGE=ghcr.io/luftaquila/qollab:0.1.8
RENDER_IMAGE=ghcr.io/luftaquila/qollab-renderer:0.1.8
ENGINE_SOCKET=/var/run/docker.sock
RENDERER_NAMESPACE=qollab
RENDER_WARM_MS=30000
BUILD_DEBOUNCE_MS=1000

# Optional: serve only this published project at /docs/.
DOCS_PROJECT=
